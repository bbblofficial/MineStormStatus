<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.minestorm</groupId>
    <artifactId>MineStormStatus</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>MineStormStatus</name>
    <description>Player status, auto-AFK and action bar HUD for Paper/Purpur.</description>

    <properties>
        <!-- Defaults = Java 21 build (profile java21). Override with -Pjava17. -->
        <java.version>21</java.version>
        <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <profiles>
        <!-- Java 17 build: compiled against Paper 1.20.4 API (last Paper API that runs on Java 17). -->
        <profile>
            <id>java17</id>
            <properties>
                <java.version>17</java.version>
                <paper.version>1.20.4-R0.1-SNAPSHOT</paper.version>
            </properties>
        </profile>
        <!-- Java 21 build: compiled against Paper 1.21.4 API. -->
        <profile>
            <id>java21</id>
            <properties>
                <java.version>21</java.version>
                <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
            </properties>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (includes Adventure + MiniMessage). Also works on Purpur. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}-java${java.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
        </plugins>
    </build>
</project>
